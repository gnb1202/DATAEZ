# ── Database ──
POSTGRES_USER=dataez
POSTGRES_PASSWORD=          # REQUIRED: set a strong password
POSTGRES_DB=dataez

# ── Storage ──
STORAGE_BACKEND=s3
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=your-dataez-bucket
S3_PREFIX=uploads

# ── OpenAI ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano
OPENAI_ORCHESTRATOR_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG (pgvector) ──
RAG_ENABLED=true

# ── Upload ──
MAX_UPLOAD_SIZE_MB=20

# ── Auth / JWT ──
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=120
JWT_REFRESH_EXP_DAYS=14

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Rate Limiting ──
AUTH_RATE_LIMIT_PER_MINUTE=20
QUERY_RATE_LIMIT_PER_MINUTE=60

# ── CORS ──
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
