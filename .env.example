# ─────────────────────────────────────────────────────────────────
# DATAEZ — local development defaults.
#
#   cp .env.example .env   → fill in OPENAI_API_KEY → docker compose up
#
# Every other value below already works for a local run. Nothing here is
# a real credential.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED: the only value you must supply ──
OPENAI_API_KEY=sk-...

# ── Environment ──
# `production` tightens config validation (rejects the dev JWT secret below).
APP_ENV=development

# ── Database ──
POSTGRES_USER=dataez
POSTGRES_PASSWORD=dataez_local_dev
POSTGRES_DB=dataez

# ── Auth / JWT ──
# Dev-only value. APP_ENV=production rejects any secret containing "dev"
# or shorter than 32 chars, so this cannot be shipped by accident.
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-insecure-local-jwt-secret-do-not-deploy
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=120
JWT_REFRESH_EXP_DAYS=14

# ── Storage ──
# `local` writes to LOCAL_STORAGE_PATH; no AWS account needed.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads
S3_PREFIX=uploads

# Only needed when STORAGE_BACKEND=s3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=

# ── OpenAI ──
OPENAI_MODEL=gpt-5.4
OPENAI_ORCHESTRATOR_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG (pgvector) ──
RAG_ENABLED=true
METRIC_SCHEDULER_ENABLED=true

# ── Upload ──
MAX_UPLOAD_SIZE_MB=20
IMPORT_CLEANUP_ENABLED=true

# ── Rate Limiting ──
# Process-local, shared across threads; deploy with one API worker/replica.
AUTH_RATE_LIMIT_PER_MINUTE=20
QUERY_RATE_LIMIT_PER_MINUTE=60

# ── CORS ──
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Frontend build args. Replace both origins before building for production.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public frontend HTTPS origin; pending until a service domain is assigned.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durable search index worker; requests remain queued while disabled.
INDEX_WORKER_ENABLED=true

# Optional private S3-compatible storage (server only).
# Copy endpoint and region from provider settings; never use NEXT_PUBLIC_ for keys.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
