# Configure in the separate API project, not the web project.
APP_ENV=production
RUNTIME_MODE=serverless
# Copy the actual Transaction pooler URI from Supabase Connect; require TLS.
DATABASE_URL=
OPENAI_API_KEY=
JWT_SECRET_KEY=
ALLOWED_ORIGINS=https://dataez.vercel.app
STORAGE_BACKEND=supabase
SUPABASE_URL=https://whbygnzoaehvlddltwlb.supabase.co
SUPABASE_STORAGE_BUCKET=dataez-files
SUPABASE_SECRET_KEY=
S3_PREFIX=uploads
# Serverless profile defaults: min=0, max=2; no prepared statements or startup DDL.
# Enable only after installing maintenance_runs and configuring Supabase Cron.
MAINTENANCE_ENABLED=false
MAINTENANCE_SECRET=
AI_USER_REQUESTS_PER_DAY=30
AI_TOTAL_REQUESTS_PER_DAY=100
AGENT_TIMEOUT_SECONDS=200
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOKEN_BUDGET=24000
# A dedicated Vercel bypass is kept in Supabase Vault, never in frontend config.
