# Copy to .env.public at repository root. Never commit the populated file.
# Point this DNS name to the server's static IPv4 before first public startup.
PUBLIC_HOST=demo.example.com
PUBLIC_ORIGIN=https://demo.example.com

POSTGRES_USER=dataez
POSTGRES_DB=dataez
# Generate a URL-safe password: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
# Generate a different secret using the same command.
JWT_SECRET_KEY=
OPENAI_API_KEY=

OPENAI_MODEL=gpt-5.4
OPENAI_ORCHESTRATOR_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_ENABLED=true
INDEX_WORKER_ENABLED=true
METRIC_SCHEDULER_ENABLED=true
IMPORT_CLEANUP_ENABLED=true
MAX_UPLOAD_SIZE_MB=20
AUTH_RATE_LIMIT_PER_MINUTE=20
QUERY_RATE_LIMIT_PER_MINUTE=60
